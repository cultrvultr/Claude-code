{
  "name": "fortnite-insights-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Automated, machine-first blog covering Fortnite, Fortnite Creative and UEFN. Data sourced primarily from Chartis (https://chartis.gg).",
  "license": "CC-BY-4.0",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "validate": "node scripts/validate-post.mjs",
    "test": "node scripts/test-generator.mjs && node scripts/test-news.mjs",
    "generate": "node scripts/generate-insight-post.mjs",
    "scrape": "node scripts/scrape-news.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "gray-matter": "^4.0.3"
  }
}
